# Paths are relative to the repository root; configure SONORA_HOME per environment.
SONORA_HOME=.
SONORA_ENV=development
SONORA_LANGUAGE=en
SONORA_STORAGE_BACKEND=local
SONORA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
COUCHDB_USER=sonora_admin
COUCHDB_PASSWORD=
COUCHDB_URL=http://127.0.0.1:5984
OPENSEARCH_URL=http://127.0.0.1:9200
REDIS_URL=redis://127.0.0.1:6379/0
# Bootstrap image families: pin versions/digests after initial verification.
COUCHDB_IMAGE=couchdb:3
OPENSEARCH_IMAGE=opensearchproject/opensearch:3
REDIS_IMAGE=redis:8-alpine
